# ============================================================================
# ARGONQA™ ENTERPRISE PLAYWRIGHT E2E AUTOMATION — ENVIRONMENT CONFIGURATION
# ============================================================================

# Target Tenant & Environment (dev | stage | prod)
TENANT=client
ENV=dev
SAAS_DOMAIN=example.com

# Optional: Override resolved URL (e.g., Vercel/Netlify ephemeral PR preview URL)
# CUSTOM_URL=https://pr-142-client-dev.example.com

# Pin execution timezone so date/time assertions are deterministic everywhere
TIMEZONE=UTC

# Browser matrix (chromium | firefox | webkit | all-desktop)
BROWSERS=chromium

# Execution tuning
SLOWMO=0
SKIP_AUTH_SETUP=true

# Multi-Cloud Secret Broker ('env' | 'vault' | 'doppler' | 'aws-sm')
CREDENTIAL_PROVIDER=env
TEST_USERNAME=qa-automation@example.com
TEST_PASSWORD=replace-with-secure-password

# Optional HashiCorp Vault / Doppler Settings
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=replace-with-vault-token
# VAULT_SECRET_PATH=v1/secret/data/argonqa/client/dev
# DOPPLER_TOKEN=dp.st.dev.replace-with-token

# Multi-Provider TestOps Integration (TestRail / Xray / Qase / Zephyr)
TMS_PROVIDER=testrail
TMS_URL=https://testops.example.com
TMS_TOKEN=replace-with-tms-api-token
TMS_PROJECT_ID=PRJ
TMS_FOLDER_ID=10

# Issue Tracker (Jira / Linear / GitHub Issues) Integration
ISSUE_TRACKER_URL=https://linear.app/example
ISSUE_TRACKER_EMAIL=qa@example.com
ISSUE_TRACKER_TOKEN=replace-with-issue-tracker-token

# Agentic Engineering Layer (Google Antigravity / Gemini 4 Argon)
AI_ENABLED=true
AI_MODEL=gemini-4-argon
