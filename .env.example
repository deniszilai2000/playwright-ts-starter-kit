# ============================================================================
# ENTERPRISE PLAYWRIGHT E2E AUTOMATION — ENVIRONMENT CONFIGURATION
# ============================================================================

# Target Tenant & Environment (dev | stage | prod)
TENANT=client
ENV=dev
SAAS_DOMAIN=example.com

# Optional: Override resolved URL (e.g., ephemeral PR preview environment)
# CUSTOM_URL=https://pr-142-client-dev.example.com

# Pin execution timezone so date/time assertions are deterministic everywhere
TIMEZONE=UTC

# Browser matrix (chromium | firefox | webkit | all-desktop)
BROWSERS=chromium

# Execution tuning
SLOWMO=0
SKIP_AUTH_SETUP=true

# Credential Provider ('env' locally/CI secrets, or 'vault' for HashiCorp Vault)
CREDENTIAL_PROVIDER=env
TEST_USERNAME=qa-automation@example.com
TEST_PASSWORD=replace-with-secure-password

# Optional HashiCorp Vault Settings (used when CREDENTIAL_PROVIDER=vault)
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=replace-with-vault-token
# VAULT_SECRET_PATH=v1/secret/data/qa/dev

# Test Management System (Testmo / TestRail / Xray) Integration
TMS_URL=https://acme.testmo.net
TMS_TOKEN=replace-with-tms-api-token
TMS_PROJECT_ID=1
TMS_FOLDER_ID=10

# Issue Tracker (Jira / Linear) Integration (used by Antigravity skills, not runtime tests)
ISSUE_TRACKER_URL=https://acme.atlassian.net
ISSUE_TRACKER_EMAIL=qa@example.com
ISSUE_TRACKER_TOKEN=replace-with-issue-tracker-token

# AI Layer Configuration (Antigravity / Gemini 4 Argon)
AI_ENABLED=true
AI_MODEL=gemini-4-argon
